#!/bin/sh
# Sauvegarde quotidienne de la base, installée en /etc/cron.daily/hr-sauvegarde.
# Garde 30 jours de dumps dans /var/backups/hr. Ces copies restent sur le serveur :
# les recopier ailleurs régulièrement (ou y brancher la sauvegarde de l'établissement).
set -e
mariadb-dump --single-transaction hr | gzip > /var/backups/hr/hr-$(date +%F).sql.gz
find /var/backups/hr -name 'hr-*.sql.gz' -mtime +30 -delete
